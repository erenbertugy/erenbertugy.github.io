---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>{SITE_TITLE}</h1>
	<p class="intro">{SITE_DESCRIPTION}</p>

	<section aria-labelledby="son-yazilar">
		<h2 id="son-yazilar">Son yazılar</h2>
		{posts.length > 0 ? <PostList posts={posts} headingLevel={3} /> : (
			<p class="empty">Henüz yazı yok.</p>
		)}
	</section>

	<p class="all-posts">
		<a href="/yazilar">Tüm yazılar</a>
	</p>
</BaseLayout>

<style>
	.intro {
		max-width: 60ch;
		margin-bottom: var(--space-5);
		color: var(--color-muted);
		font-size: 1.125em;
	}

	.empty {
		color: var(--color-muted);
	}

	.all-posts {
		margin: var(--space-4) 0 0;
		font-weight: 700;
	}
</style>
