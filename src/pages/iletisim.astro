---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`İletişim | ${SITE_TITLE}`}
	description="Bana e-posta, GitHub veya LinkedIn üzerinden ulaşabilirsiniz."
>
	<h1>İletişim</h1>

	<p>
		Bir sorunuz, öneriniz ya da düzeltmek istediğiniz bir şey varsa bana yazabilirsiniz. En hızlı
		yol e-posta. Aşağıdaki simgelerden birine dokunarak bana ulaşabilirsiniz.
	</p>

	<div class="contact-social">
		<SocialLinks size="lg" />
	</div>
</BaseLayout>

<style>
	.contact-social {
		margin-top: var(--space-3);
	}
</style>
