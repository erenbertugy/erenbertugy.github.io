---
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from '../consts';

interface Props {
	/** "lg" iletişim sayfası gibi geniş alanlarda daha büyük ikonlar gösterir. */
	size?: 'sm' | 'lg';
	class?: string;
}

const { size = 'sm', class: className } = Astro.props;

// consts.ts içinde boş veya [DOLDUR] kalan değerler için ilgili ikon gösterilmez.
const isReady = (value: string | undefined): value is string =>
	Boolean(value && value.trim() !== '' && !value.includes('[DOLDUR]'));

const links = [
	{ key: 'github', label: 'GitHub profilim', href: GITHUB_URL, external: true },
	{ key: 'linkedin', label: 'LinkedIn profilim', href: LINKEDIN_URL, external: true },
	{ key: 'email', label: 'E-posta gönder', href: `mailto:${EMAIL}`, external: false },
].filter((link) => isReady(link.href));
---

<ul
	class:list={['social-links', className, { 'social-links--lg': size === 'lg' }]}
	role="list"
	aria-label="Sosyal bağlantılar"
>
	{
		links.map((link) => (
			<li>
				<a
					class="social-link"
					href={link.href}
					title={link.label}
					aria-label={link.label}
					target={link.external ? '_blank' : undefined}
					rel={link.external ? 'noopener noreferrer' : undefined}
				>
					{link.key === 'github' && (
						<svg
							class="icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								fill="currentColor"
								d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
							/>
						</svg>
					)}
					{link.key === 'linkedin' && (
						<svg
							class="icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								fill="currentColor"
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							/>
						</svg>
					)}
					{link.key === 'email' && (
						<svg
							class="icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								fill="currentColor"
								d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
							/>
						</svg>
					)}
				</a>
			</li>
		))
	}
</ul>

<style>
	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.social-links li {
		margin: 0;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		border: 1px solid transparent;
		border-radius: 50%;
		color: var(--color-muted);
		text-decoration: none;
		transition:
			color 120ms ease-out,
			background-color 120ms ease-out,
			border-color 120ms ease-out;
	}

	.social-link:hover {
		border-color: var(--color-border);
		background-color: var(--color-surface);
		color: var(--color-accent-strong);
	}

	.social-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		color: var(--color-accent-strong);
	}

	.icon {
		display: block;
		width: 20px;
		height: 20px;
	}

	/* İletişim sayfası: daha büyük ikonlar ve dokunma hedefleri. */
	.social-links--lg {
		gap: var(--space-2);
	}

	.social-links--lg .social-link {
		min-width: 64px;
		min-height: 64px;
	}

	.social-links--lg .icon {
		width: 48px;
		height: 48px;
	}

	@media (max-width: 360px) {
		.social-links--lg {
			gap: var(--space-1);
		}

		.social-links--lg .social-link {
			min-width: 48px;
			min-height: 48px;
		}

		.social-links--lg .icon {
			width: 36px;
			height: 36px;
		}
	}
</style>
