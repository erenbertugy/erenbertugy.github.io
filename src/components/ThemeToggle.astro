---
/*
  Açık/koyu tema düğmesi.
  Tema, <head> içindeki satır içi script ile sayfa boyanmadan önce uygulanır.
  Düğme varsayılan olarak gizlidir: JS çalışmıyorsa görünmez, sistem teması geçerli kalır.
*/
---

<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label="Temayı değiştir"
	aria-pressed="false"
	hidden
>
	<svg
		class="icon icon-sun"
		viewBox="0 0 24 24"
		width="20"
		height="20"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
	</svg>
	<svg
		class="icon icon-moon"
		viewBox="0 0 24 24"
		width="20"
		height="20"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
</button>

<script is:inline>
	(function () {
		var STORAGE_KEY = 'theme';
		var root = document.documentElement;
		var button = document.querySelector('[data-theme-toggle]');

		if (!button) return;

		function systemTheme() {
			return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
				? 'dark'
				: 'light';
		}

		function currentTheme() {
			var theme = root.getAttribute('data-theme');
			return theme === 'dark' || theme === 'light' ? theme : systemTheme();
		}

		function syncButton(theme) {
			button.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
		}

		function applyTheme(theme) {
			root.setAttribute('data-theme', theme);
			syncButton(theme);
		}

		function saveTheme(theme) {
			try {
				localStorage.setItem(STORAGE_KEY, theme);
			} catch (error) {
				/* localStorage kullanılamıyorsa seçim yalnızca bu sayfada geçerli olur. */
			}
		}

		syncButton(currentTheme());
		button.hidden = false;

		button.addEventListener('click', function () {
			var nextTheme = currentTheme() === 'dark' ? 'light' : 'dark';
			applyTheme(nextTheme);
			saveTheme(nextTheme);
		});
	})();
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 2.75rem; /* 44px dokunma hedefi */
		block-size: 2.75rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background-color: var(--color-surface);
		color: var(--color-text);
		line-height: 1;
		cursor: pointer;
		transition:
			color 120ms ease-out,
			border-color 120ms ease-out,
			background-color 120ms ease-out;
	}

	.theme-toggle[hidden] {
		display: none;
	}

	.theme-toggle:hover {
		border-color: var(--color-accent);
		background-color: var(--color-bg);
		color: var(--color-accent-strong);
	}

	.theme-toggle .icon {
		display: none;
		inline-size: 1.25rem;
		block-size: 1.25rem;
	}

	/* Açık temada ay, koyu temada güneş ikonu görünür. */
	.theme-toggle .icon-moon {
		display: block;
	}

	.theme-toggle[aria-pressed='true'] .icon-moon {
		display: none;
	}

	.theme-toggle[aria-pressed='true'] .icon-sun {
		display: block;
	}
</style>
