---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="site-header">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<nav aria-label="Ana menü">
			<HeaderLink href="/">Ana Sayfa</HeaderLink>
			<HeaderLink href="/blog">Yazılar</HeaderLink>
			<HeaderLink href="/about">Hakkımda</HeaderLink>
			<HeaderLink href="/iletisim">İletişim</HeaderLink>
		</nav>
	</div>
</header>
<style>
	header {
		margin: 0;
		padding: 0 var(--space-3);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1.5em;
	}
	.site-title {
		padding: 1em 0;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.5em;
	}
	nav :global(a) {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav :global(a.active) {
		border-bottom-color: var(--accent);
	}
	@media (max-width: 480px) {
		.site-header {
			justify-content: center;
		}
	}
</style>
