---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<div class="site-header">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<nav aria-label="Ana menü">
			<HeaderLink href="/">Ana Sayfa</HeaderLink>
			<HeaderLink href="/yazilar">Yazılar</HeaderLink>
			<HeaderLink href="/hakkimda">Hakkımda</HeaderLink>
			<HeaderLink href="/iletisim">İletişim</HeaderLink>
		</nav>
		<div class="theme-toggle-slot">
			<ThemeToggle />
		</div>
	</div>
</header>
<style>
	header {
		margin: 0;
		padding: 0 var(--space-3);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}
	.site-header {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'title toggle'
			'nav nav';
		align-items: center;
		gap: 0 var(--space-2);
	}
	.site-title {
		grid-area: title;
		padding: 1em 0;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
	}
	nav {
		grid-area: nav;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.5em;
	}
	nav :global(a) {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav :global(a.active) {
		border-bottom-color: var(--accent);
	}
	/* Düğme JS yokken gizli olsa da yeri ayrılsın; düzen kaymasın. */
	.theme-toggle-slot {
		grid-area: toggle;
		display: flex;
		justify-content: flex-end;
		min-inline-size: 2.75rem;
	}
	@media (min-width: 40rem) {
		.site-header {
			grid-template-columns: 1fr auto auto;
			grid-template-areas: 'title nav toggle';
		}
	}
</style>
