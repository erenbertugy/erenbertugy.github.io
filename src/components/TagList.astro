---
import { tagToSlug } from '../lib/tags';

interface Props {
	tags?: string[];
	centered?: boolean;
}

const { tags = [], centered = false } = Astro.props;

// Aynı etiket birden fazla yazılmışsa rozeti bir kez göster.
const uniqueTags = [...new Set(tags.filter((tag) => tag.trim() !== ''))];
---

{
	uniqueTags.length > 0 && (
		<ul class:list={['tag-list', { 'is-centered': centered }]}>
			{uniqueTags.map((tag) => (
				<li>
					<a class="tag" href={`/etiket/${tagToSlug(tag)}/`} rel="tag" aria-label={`${tag} etiketindeki yazılar`}>
						{tag}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin: var(--space-1) 0 0;
		padding: 0;
		list-style: none;
	}

	.tag-list.is-centered {
		justify-content: center;
	}

	/* Global `li + li` boşluğu yatay rozetleri etkilemesin. */
	.tag-list li,
	.tag-list li + li {
		margin: 0;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem; /* 44px dokunma hedefi */
		padding: 0 var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background-color: var(--color-surface);
		color: var(--color-accent);
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.2;
		text-decoration: none;
	}

	.tag:hover {
		border-color: var(--color-accent-strong);
		color: var(--color-accent-strong);
		text-decoration: underline;
	}
</style>
